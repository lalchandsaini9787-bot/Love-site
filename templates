<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SurpriseQR - Premium</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">
</head>
<body class="bg-[#08070B] text-white font-[Poppins] min-h-screen flex justify-center items-center p-4">
<div class="absolute inset-0 bg-gradient-to-br from-purple-600/30 via-pink-500/20 to-orange-400/20 blur-[100px]"></div>

<div class="relative w-full max-w-[420px] bg-white/[0.07] backdrop-blur-[30px] border border-white/10 rounded-[32px] p-7 shadow-2xl">
    <h1 class="text-[28px] font-extrabold text-center leading-none">Create Magic ✨</h1>
    <p class="text-center text-white/50 text-[13px] mt-2">Bday, Love, Sorry - QR me Surprise</p>

    <form action="/create" method="POST" class="mt-7 space-y-4">
        <div class="grid grid-cols-2 gap-3">
            <label><input type="radio" name="theme" value="bday" checked class="peer hidden"><div class="peer-checked:bg-white peer-checked:text-black bg-white/10 p-4 rounded-2xl text-center cursor-pointer border border-white/10 transition-all">🎂<br><span class="text-sm font-semibold">Birthday</span></div></label>
            <label><input type="radio" name="theme" value="love" class="peer hidden"><div class="peer-checked:bg-white peer-checked:text-black bg-white/10 p-4 rounded-2xl text-center cursor-pointer border border-white/10 transition-all">❤️<br><span class="text-sm font-semibold">Love</span></div></label>
        </div>

        <input name="name" required placeholder="Uska Naam (e.g. Simran)" class="w-full p-4 rounded-2xl bg-white/[0.08] border border-white/10 outline-none focus:border-white/30 placeholder:text-white/30">
        <textarea name="message" required placeholder="Apna secret message yaha likho... Dil se likhna, wahi dikhega." class="w-full p-4 rounded-2xl bg-white/[0.08] border border-white/10 outline-none h-[130px] placeholder:text-white/30 focus:border-white/30"></textarea>

        <button class="w-full bg-white text-black font-bold p-4 rounded-2xl text-[16px] hover:scale-[0.98] transition-all">Generate QR Surprise 🚀</button>
        <p class="text-center text-[11px] text-white/30">100% Free - Scan karte hi surprise khulega</p>
    </form>
</div>
</body>
</html>
